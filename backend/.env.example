# Backend settings. Copy to .env and fill in your own key. NEVER commit .env.
PORT=4000
# Browser origin allowed to call this API
CORS_ORIGIN=http://localhost:3000

# AI Advisor (Groq). The key stays on the server and is never sent to the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
